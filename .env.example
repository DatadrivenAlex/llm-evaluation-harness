# Copy to .env for local overrides. The CLI reads .env from the working
# directory and does not overwrite variables that are already exported.
# The default path is fully offline: no API key is read or required.

LLM_EVAL_MIN_PASS_RATE=0.8
LLM_EVAL_MIN_TOKEN_F1=0.5
LLM_EVAL_MIN_FAITHFULNESS=0.6
LLM_EVAL_MAX_HALLUCINATION_RATE=0.2
LLM_EVAL_REQUIRE_EXACT_MATCH=false

# Intentionally unused. The harness does not call a hosted model.
# LLM_EVAL_API_KEY=
# LLM_EVAL_BASE_URL=
# LLM_EVAL_MODEL=
